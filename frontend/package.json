{
  "name": "gm3-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:local": "npx cross-env VITE_BACKEND_SERVER_IP=localhost VITE_BACKEND_PROTOCOL=http VITE_BACKEND_PORT=8005 vite build && npm run copy:dist",
    "build:prod": "npx cross-env VITE_BACKEND_SERVER_IP=golf.bronnerapp.com VITE_BACKEND_PROTOCOL=https VITE_BACKEND_PORT=443 vite build && npm run copy:dist",
    "build:stage": "npx cross-env VITE_BACKEND_SERVER_IP=golf-stage.lab.bronnerapp.com VITE_BACKEND_PROTOCOL=https VITE_BACKEND_PORT=443 vite build && npm run copy:dist",
    "copy:dist": "node -e \"require('fs').cpSync('dist', '../backend/dist', {recursive: true})\"",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "@sentry/react": "^11.7.0",
    "@tanstack/react-table": "^9.3.1",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "happy-dom": "^21.0.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
