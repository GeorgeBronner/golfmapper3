# Add this to your .dockerignore file
.venv/
__pycache__/
*.pyc
.idea

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables — **/ is required: unlike .gitignore, a bare
# pattern in .dockerignore only matches at the context root, so plain
# ".env" would NOT exclude app/.env and its secrets would end up in the
# image. Runtime config comes from compose `environment:` instead.
**/.env
**/.env.*

**/garmin.db
**/golf_mapper.db
static/user_maps/